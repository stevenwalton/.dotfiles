# Skeleton for sshd fail2ban jail
# This is an example of things you might want to do
[sshd]
enabled = true
filter = sshd
banaction = firewallcmd-rich-rules[actiontype=]
banaction_allports = firewallcmd-rich-rules[actiontype=]
backend = systemd
maxretry = 3
findtime = 7d
bantime = 3mo
increment = true
ignoreip = 127.0.0.1/8 
rejecttype = icmp-port-unreachable
